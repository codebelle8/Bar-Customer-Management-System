# セッション署名用の秘密鍵（32文字以上のランダムな文字列）。本番では必ず変更してください。
SESSION_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# 本番の PostgreSQL（例：Supabase 東京リージョン）。未設定の場合は開発用の組み込み DB（PGlite）を ./.data に作成します。
# Supabase の場合は「Transaction pooler」の接続文字列を指定してください。
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# 確認用の公開環境で、ログイン画面より前に求める閲覧用パスワード（未設定なら無効）
# SITE_PASSWORD=

# 組み込み DB に投入するデータ：demo（サンプルデータあり）/ clean（店舗・料金・初期アカウントのみ）
SEED_MODE=demo
